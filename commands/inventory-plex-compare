#!/usr/bin/env bash
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

source "${SCRIPT_DIR}/../lib/exit_codes.sh"
source "${SCRIPT_DIR}/../lib/cli_errors.sh"
source "${SCRIPT_DIR}/../lib/cli_options.sh"
source "${SCRIPT_DIR}/../lib/logger.sh"
source "${SCRIPT_DIR}/../lib/inventory.sh"
source "${SCRIPT_DIR}/../lib/plex_config.sh"
source "${SCRIPT_DIR}/../lib/plex_api.sh"
source "${SCRIPT_DIR}/../lib/plex_libraries.sh"
source "${SCRIPT_DIR}/../lib/plex_media.sh"
source "${SCRIPT_DIR}/../lib/plex_compare.sh"
source "${SCRIPT_DIR}/../lib/plex_inventory.sh"
source "${SCRIPT_DIR}/../lib/inventory_plex_compare.sh"

cmd_inventory_plex_compare() {
    ptk_parse_common_options "$@" || return $?

    if [[ "${#PTK_POSITIONAL[@]}" -ne 2 ]]; then
        ptk_usage_error "A local inventory file and a Plex library key are required."
        local rc=$?
        ptk_log_command_end "inventory-plex-compare" "$rc"
        return "$rc"
    fi

    if ptk_is_fix_enabled; then
        ptk_usage_error "inventory-plex-compare is read-only and does not support --fix."
        local rc=$?
        ptk_log_command_end "inventory-plex-compare" "$rc"
        return "$rc"
    fi

    local local_inventory="${PTK_POSITIONAL[0]}"
    local library_key="${PTK_POSITIONAL[1]}"

    ptk_log_command_start "inventory-plex-compare"

    ptk_load_plex_config "${PTK_PLEX_CONFIG:-config/plex.conf}" || {
        local rc=$?
        ptk_log_command_end "inventory-plex-compare" "$rc"
        return "$rc"
    }

    ptk_inventory_load_config "${PTK_INVENTORY_CONFIG:-config/inventory.conf}" || {
        local rc=$?
        ptk_log_command_end "inventory-plex-compare" "$rc"
        return "$rc"
    }

    ptk_plex_library_exists "$library_key" || {
        ptk_error "Plex library not found: $library_key"
        ptk_log_command_end "inventory-plex-compare" "$PTK_EXIT_ERROR"
        return "$PTK_EXIT_ERROR"
    }

    ptk_inventory_plex_compare "$local_inventory" "$library_key"
    local rc=$?

    ptk_is_valid_exit_code "$rc" || rc="$PTK_EXIT_ERROR"
    ptk_log_command_end "inventory-plex-compare" "$rc"
    return "$rc"
}
