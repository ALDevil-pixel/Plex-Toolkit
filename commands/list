#!/usr/bin/env bash
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

source "${SCRIPT_DIR}/../lib/exit_codes.sh"
source "${SCRIPT_DIR}/../lib/cli_errors.sh"
source "${SCRIPT_DIR}/../lib/cli_options.sh"
source "${SCRIPT_DIR}/../lib/logger.sh"
source "${SCRIPT_DIR}/../lib/list.sh"

cmd_list() {
    ptk_parse_common_options "$@"

    if [[ "${#PTK_POSITIONAL[@]}" -gt 1 ]]; then
        ptk_usage_error "Too many positional arguments."
        local rc=$?
        ptk_log_command_end "list" "$rc"
        return "$rc"
    fi

    local target="${PTK_POSITIONAL[0]:-}"

    if [[ -n "$target" && ! -e "$target" ]]; then
        ptk_error "Path not found: $target"
        ptk_log_command_end "list" "$PTK_EXIT_ERROR"
        return "$PTK_EXIT_ERROR"
    fi

    ptk_log_command_start "list"
    ptk_is_verbose && ptk_log_verbose "Target: ${target:-default}"

    ptk_list "$target"
    local rc=$?
    ptk_is_valid_exit_code "$rc" || rc="$PTK_EXIT_ERROR"

    ptk_log_command_end "list" "$rc"
    return "$rc"
}
