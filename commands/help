#!/usr/bin/env bash
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

source "${SCRIPT_DIR}/../lib/exit_codes.sh"
source "${SCRIPT_DIR}/../lib/cli_errors.sh"
source "${SCRIPT_DIR}/../lib/cli_options.sh"
source "${SCRIPT_DIR}/../lib/logger.sh"
source "${SCRIPT_DIR}/../lib/help.sh"

cmd_help() {
    ptk_parse_common_options "$@"

    if [[ "${#PTK_POSITIONAL[@]}" -gt 1 ]]; then
        ptk_usage_error "Too many positional arguments."
        local rc=$?
        ptk_log_command_end "help" "$rc"
        return "$rc"
    fi

    if ptk_is_fix_enabled; then
        ptk_usage_error "help does not support --fix."
        local rc=$?
        ptk_log_command_end "help" "$rc"
        return "$rc"
    fi

    ptk_log_command_start "help"
    [[ "$PTK_VERBOSE" -eq 1 ]] && ptk_log_verbose "Showing help"

    ptk_help_show "${PTK_POSITIONAL[0]:-}"
    local rc=$?

    ptk_is_valid_exit_code "$rc" || rc="$PTK_EXIT_ERROR"
    ptk_log_command_end "help" "$rc"
    return "$rc"
}
