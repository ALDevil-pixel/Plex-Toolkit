#!/usr/bin/env bash
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

source "${SCRIPT_DIR}/../lib/exit_codes.sh"
source "${SCRIPT_DIR}/../lib/cli_errors.sh"
source "${SCRIPT_DIR}/../lib/cli_options.sh"
source "${SCRIPT_DIR}/../lib/logger.sh"
source "${SCRIPT_DIR}/../lib/plex_config.sh"
source "${SCRIPT_DIR}/../lib/plex_api.sh"
source "${SCRIPT_DIR}/../lib/plex_libraries.sh"
source "${SCRIPT_DIR}/../lib/plex_media.sh"

cmd_plex_media() {
    ptk_parse_common_options "$@" || return $?

    if [[ "${#PTK_POSITIONAL[@]}" -ne 1 ]]; then
        ptk_usage_error "A Plex library key is required."
        local rc=$?
        ptk_log_command_end "plex-media" "$rc"
        return "$rc"
    fi

    local library_key="${PTK_POSITIONAL[0]}"

    ptk_log_command_start "plex-media"

    ptk_load_plex_config "${PTK_PLEX_CONFIG:-config/plex.conf}" || {
        local rc=$?
        ptk_log_command_end "plex-media" "$rc"
        return "$rc"
    }

    ptk_plex_library_exists "$library_key" || {
        ptk_error "Plex library not found: $library_key"
        ptk_log_command_end "plex-media" "$PTK_EXIT_ERROR"
        return "$PTK_EXIT_ERROR"
    }

    echo "Plex library: $library_key"
    echo "ratingKey	type	title	year	librarySectionID	librarySectionTitle	updatedAt"

    ptk_plex_list_media "$library_key"
    local rc=$?

    ptk_is_valid_exit_code "$rc" || rc="$PTK_EXIT_ERROR"
    ptk_log_command_end "plex-media" "$rc"
    return "$rc"
}
