#!/usr/bin/env bash
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

source "${SCRIPT_DIR}/../lib/exit_codes.sh"
source "${SCRIPT_DIR}/../lib/cli_errors.sh"
source "${SCRIPT_DIR}/../lib/cli_options.sh"
source "${SCRIPT_DIR}/../lib/logger.sh"
source "${SCRIPT_DIR}/../lib/plex_config.sh"

cmd_plex_config() {
    ptk_parse_common_options "$@" || return $?

    if [[ "${#PTK_POSITIONAL[@]}" -gt 0 ]]; then
        ptk_usage_error "This command does not accept positional arguments."
        local rc=$?
        ptk_log_command_end "plex-config" "$rc"
        return "$rc"
    fi

    ptk_log_command_start "plex-config"

    ptk_load_plex_config "${PTK_PLEX_CONFIG:-config/plex.conf}" || {
        local rc=$?
        ptk_log_command_end "plex-config" "$rc"
        return "$rc"
    }

    # Never print the token.
    echo "Plex configuration: OK"
    echo "URL            : $PLEX_URL"
    echo "Timeout        : ${PLEX_TIMEOUT}s"
    echo "Verify TLS     : $PLEX_VERIFY_TLS"
    echo "Retries        : $PLEX_RETRIES"
    echo "Token          : configured"

    ptk_log_command_end "plex-config" 0
    return 0
}
