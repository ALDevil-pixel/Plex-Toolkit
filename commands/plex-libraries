#!/usr/bin/env bash
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

source "${SCRIPT_DIR}/../lib/exit_codes.sh"
source "${SCRIPT_DIR}/../lib/cli_errors.sh"
source "${SCRIPT_DIR}/../lib/cli_options.sh"
source "${SCRIPT_DIR}/../lib/logger.sh"
source "${SCRIPT_DIR}/../lib/plex_config.sh"
source "${SCRIPT_DIR}/../lib/plex_api.sh"
source "${SCRIPT_DIR}/../lib/plex_libraries.sh"

cmd_plex_libraries() {
    ptk_parse_common_options "$@" || return $?

    if [[ "${#PTK_POSITIONAL[@]}" -gt 0 ]]; then
        ptk_usage_error "This command does not accept positional arguments."
        local rc=$?
        ptk_log_command_end "plex-libraries" "$rc"
        return "$rc"
    fi

    ptk_log_command_start "plex-libraries"

    ptk_load_plex_config "${PTK_PLEX_CONFIG:-config/plex.conf}" || {
        local rc=$?
        ptk_log_command_end "plex-libraries" "$rc"
        return "$rc"
    }

    ptk_plex_list_libraries
    local rc=$?

    ptk_is_valid_exit_code "$rc" || rc="$PTK_EXIT_ERROR"
    ptk_log_command_end "plex-libraries" "$rc"
    return "$rc"
}
