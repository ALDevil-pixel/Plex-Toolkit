#!/usr/bin/env bash
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/../lib/exit_codes.sh"
source "${SCRIPT_DIR}/../lib/cli_errors.sh"
source "${SCRIPT_DIR}/../lib/cli_options.sh"
source "${SCRIPT_DIR}/../lib/logger.sh"
source "${SCRIPT_DIR}/../lib/rename.sh"

cmd_rename() {
    ptk_parse_common_options "$@"

    if [[ "${#PTK_POSITIONAL[@]}" -gt 1 ]]; then
        ptk_usage_error "Too many positional arguments."
        local rc=$?
        ptk_log_command_end "rename" "$rc"
        return "$rc"
    fi

    local target="${PTK_POSITIONAL[0]:-}"

    if [[ -n "$target" ]] && ! ptk_require_directory "$target"; then
        local rc=$?
        ptk_log_command_end "rename" "$rc"
        return "$rc"
    fi

    ptk_log_command_start "rename"
    [[ "$PTK_VERBOSE" -eq 1 ]] && ptk_log_verbose "Command: rename"

    if ptk_is_fix_enabled; then
        ptk_rename --fix "$target"
    else
        ptk_rename --dry-run "$target"
    fi

    local rc=$?
    ptk_is_valid_exit_code "$rc" || rc="$PTK_EXIT_ERROR"
    ptk_log_command_end "rename" "$rc"
    return "$rc"
}
