#!/usr/bin/env bash
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

source "${SCRIPT_DIR}/../lib/exit_codes.sh"
source "${SCRIPT_DIR}/../lib/cli_errors.sh"
source "${SCRIPT_DIR}/../lib/cli_options.sh"
source "${SCRIPT_DIR}/../lib/logger.sh"
source "${SCRIPT_DIR}/../lib/version.sh"

cmd_version() {
    ptk_parse_common_options "$@"

    if [[ "${#PTK_POSITIONAL[@]}" -gt 0 ]]; then
        ptk_usage_error "version does not accept positional arguments."
        local rc=$?
        ptk_log_command_end "version" "$rc"
        return "$rc"
    fi

    if ptk_is_fix_enabled; then
        ptk_usage_error "version does not support --fix."
        local rc=$?
        ptk_log_command_end "version" "$rc"
        return "$rc"
    fi

    ptk_log_command_start "version"
    ptk_is_verbose && ptk_log_verbose "Reading VERSION"

    ptk_version_show
    local rc=$?

    ptk_is_valid_exit_code "$rc" || rc="$PTK_EXIT_ERROR"
    ptk_log_command_end "version" "$rc"
    return "$rc"
}
