#!/usr/bin/env bash
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/../lib/duplicates.sh"
source "${SCRIPT_DIR}/../lib/duplicates_export.sh"

cmd_duplicates() {
    local csv=0
    local args=()

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --csv) csv=1 ;;
            *) args+=("$1") ;;
        esac
        shift
    done

    tmp=$(mktemp)
    ptk_find_duplicates "${args[@]}" | tee "$tmp"

    if [[ $csv -eq 1 ]]; then
        ptk_export_duplicates_csv "$tmp"
    fi

    rm -f "$tmp"
}
