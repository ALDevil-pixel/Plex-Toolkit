#!/usr/bin/env bash
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/../lib/library_loader.sh"
source "${SCRIPT_DIR}/../lib/duplicates.sh"

cmd_duplicates() {
    if [[ $# -eq 0 ]]; then
        while IFS='|' read -r name path; do
            echo "=== $name ==="
            ptk_find_duplicates "$path"
            echo
        done < <(ptk_load_libraries)
    else
        ptk_find_duplicates "$@"
    fi
}
