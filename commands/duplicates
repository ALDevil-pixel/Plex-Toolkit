#!/usr/bin/env bash
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/../lib/duplicates.sh"
source "${SCRIPT_DIR}/../lib/duplicates_stats.sh"

cmd_duplicates() {
    local stats=0
    local args=()

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --stats) stats=1 ;;
            *) args+=("$1") ;;
        esac
        shift
    done

    tmp=$(mktemp)
    ptk_find_duplicates "${args[@]}" | tee "$tmp"

    if [[ $stats -eq 1 ]]; then
        echo
        ptk_duplicates_stats "$tmp"
    fi

    rm -f "$tmp"
}
