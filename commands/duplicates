#!/usr/bin/env bash
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/../lib/duplicates.sh"
source "${SCRIPT_DIR}/../lib/duplicates_ignore.sh"

cmd_duplicates() {
    local ignore_patterns=()
    mapfile -t ignore_patterns < <(ptk_load_ignore_file)

    while IFS= read -r file; do
        ptk_is_ignored "$file" "${ignore_patterns[@]}" && continue
        echo "$file"
    done < <(ptk_find_duplicates "$@")
}
