#!/usr/bin/env bash
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/../lib/duplicates.sh"
source "${SCRIPT_DIR}/../lib/duplicates_summary.sh"

cmd_duplicates() {
    if [[ "$1" == "--summary" ]]; then
        ptk_duplicates_summary "${2:-logs/duplicates-report.txt}"
        return
    fi
    ptk_find_duplicates "$@"
}
