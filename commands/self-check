#!/usr/bin/env bash
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

source "${SCRIPT_DIR}/../lib/exit_codes.sh"
source "${SCRIPT_DIR}/../lib/cli_errors.sh"
source "${SCRIPT_DIR}/../lib/cli_options.sh"
source "${SCRIPT_DIR}/../lib/logger.sh"
source "${SCRIPT_DIR}/../lib/self_check.sh"

cmd_self_check() {
    ptk_parse_common_options "$@"

    if [[ "${#PTK_POSITIONAL[@]}" -gt 0 ]]; then
        ptk_usage_error "self-check does not accept positional arguments."
        local rc=$?
        ptk_log_command_end "self-check" "$rc"
        return "$rc"
    fi

    if ptk_is_fix_enabled; then
        ptk_usage_error "self-check does not support --fix."
        local rc=$?
        ptk_log_command_end "self-check" "$rc"
        return "$rc"
    fi

    ptk_log_command_start "self-check"
    [[ "$PTK_VERBOSE" -eq 1 ]] && ptk_log_verbose "Running dependency checks"

    ptk_self_check_run
    local rc=$?

    ptk_is_valid_exit_code "$rc" || rc="$PTK_EXIT_ERROR"
    ptk_log_command_end "self-check" "$rc"
    return "$rc"
}
