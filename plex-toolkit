#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

run_command() {
    local command="${1:-}"
    shift || true

    if [[ -z "$command" ]]; then
        source "$ROOT/commands/help"
        cmd_help
        return $?
    fi

    case "$command" in
        anime-scan|audit|check|cleanup|doctor|duplicates|help|info|inventory|list|rename|self-check|version)
            source "$ROOT/commands/$command"
            "cmd_$command" "$@"
            return $?
            ;;
        *)
            echo "[ERROR] Unknown command: $command" >&2
            echo "Use 'plex-toolkit help' to see available commands." >&2
            return "${PTK_EXIT_USAGE:-2}"
            ;;
    esac
}

if [[ $# -eq 0 ]]; then
    run_command help
    exit $?
fi

run_command "$@"
